name: Validate and publish Python distribution

on:
  release:
    types: [published]
  workflow_dispatch:
    inputs:
      publish:
        description: Publish a validated tag to PyPI (requires configured Trusted Publisher)
        type: boolean
        default: false

permissions:
  contents: read

jobs:
  validate:
    uses: ./.github/workflows/ci.yml

  publish:
    needs: validate
    if: >-
      vars.PYPI_PUBLISH_ENABLED == 'true' &&
      (github.event_name == 'release' || inputs.publish == true)
    runs-on: ubuntu-latest
    environment:
      name: pypi
      url: https://pypi.org/p/pravda-bot
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version-file: .python-version
      - name: Require a matching version tag on main
        env:
          RELEASE_TAG: ${{ github.event.release.tag_name || github.ref_name }}
          RELEASE_REF_TYPE: ${{ github.ref_type }}
        run: |
          python - <<'PY'
          import os, re, tomllib
          from pathlib import Path
          tag = os.environ['RELEASE_TAG']
          version = tomllib.loads(Path('pyproject.toml').read_text())['project']['version']
          if os.environ['RELEASE_REF_TYPE'] != 'tag' or not re.fullmatch(r'v\d+\.\d+\.\d+', tag) or tag[1:] != version:
              raise SystemExit('Publish requires the exact vX.Y.Z project version tag')
          PY
          git merge-base --is-ancestor HEAD origin/main
      - uses: actions/download-artifact@v4
        with:
          name: package-ubuntu-latest
          path: dist/
      - name: Publish validated artifacts with PyPI Trusted Publishing
        uses: pypa/gh-action-pypi-publish@release/v1
