{
  "build": {
    "beforeDevCommand": "cargo run --release -p pravda-server",
    "beforeBuildCommand": "cargo build --release -p pravda-server",
    "frontendDist": "../.."
  },
  "package": {
    "productName": "Pravda-Bot",
    "version": "0.2.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "Pravda-Bot",
        "width": 1280,
        "height": 800
      }
    ],
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.pravda.bot",
      "icon": []
    }
  }
}
