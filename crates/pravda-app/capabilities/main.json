    "allow-ipc-market-snapshot",
    "allow-ipc-history-recent",
    "allow-ipc-history-query",
    "allow-ipc-history-export-csv",
    "allow-ipc-paper-alerts-snapshot",
    "allow-ipc-paper-snapshot",
    "allow-ipc-paper-trade",
    "allow-ipc-paper-reset",
    "allow-ipc-runtime-metrics",
    "allow-ipc-security-report",
    "allow-ipc-security-events",
    "allow-ipc-fx-status",
    "allow-ipc-public-feed",
    "allow-ipc-revolut-consent-get",
    "allow-ipc-revolut-consent-set",
