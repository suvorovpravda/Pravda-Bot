{
  "identifier": "main-ipc",
  "description": "Bundled main window only: local auth bootstrap plus authenticated read-only desktop commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-ipc-auth-status",
    "allow-ipc-auth-setup",
    "allow-ipc-auth-login",
    "allow-ipc-auth-logout",
    "allow-ipc-session-check",
    "allow-ipc-market-snapshot",
    "allow-ipc-history-recent",
    "allow-ipc-history-query",
    "allow-ipc-history-export-csv",
    "allow-ipc-paper-alerts-snapshot",
    "allow-ipc-runtime-metrics",
    "allow-ipc-fx-status"
  ]
}
