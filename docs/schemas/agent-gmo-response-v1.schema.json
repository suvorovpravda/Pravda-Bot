{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pravda GMO untrusted PAPER response v1",
  "description": "Proposal only. Never sign, trust market values, or execute an order based solely on schema validation. Native Rust risk authority must revalidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "timestamp_utc",
    "mode",
    "status",
    "confidence_score"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Rust checks that the parsed offset is UTC; freshness must be checked by caller."
    },
    "mode": {
      "const": "PAPER"
    },
    "status": {
      "enum": [
        "DECISION",
        "NO_ACTION",
        "INSUFFICIENT_DATA",
        "ERROR"
      ]
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/rationale"
        }
      ]
    },
    "decision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/paper_proposal"
        }
      ]
    },
    "missing_fields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "error_code": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      ]
    }
  },
  "$defs": {
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_regime",
        "thesis",
        "key_factors",
        "risks_identified",
        "alternatives_considered"
      ],
      "properties": {
        "market_regime": {
          "enum": [
            "TRENDING_UP",
            "TRENDING_DOWN",
            "RANGING",
            "HIGH_VOLATILITY",
            "CRISIS"
          ]
        },
        "thesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "key_factors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "risks_identified": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "alternatives_considered": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "paper_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "strategy",
        "symbol",
        "exchange",
        "notional_micros_usdt",
        "entry_price_micros_usdt",
        "stop_price_micros_usdt",
        "take_profit"
      ],
      "properties": {
        "action": {
          "enum": [
            "OPEN_LONG",
            "OPEN_SHORT"
          ]
        },
        "strategy": {
          "enum": [
            "TREND_FOLLOWING",
            "MEAN_REVERSION",
            "BREAKOUT",
            "FUNDING_RATE_ARB",
            "LIQUIDATION_CASCADE",
            "SENTIMENT_DIVERGENCE"
          ]
        },
        "symbol": {
          "enum": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT"
          ]
        },
        "exchange": {
          "enum": [
            "binance",
            "kraken"
          ]
        },
        "notional_micros_usdt": {
          "type": "integer",
          "minimum": 1
        },
        "entry_price_micros_usdt": {
          "type": "integer",
          "minimum": 1
        },
        "stop_price_micros_usdt": {
          "type": "integer",
          "minimum": 1
        },
        "take_profit": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "price_micros_usdt",
              "portion_bps"
            ],
            "properties": {
              "price_micros_usdt": {
                "type": "integer",
                "minimum": 1
              },
              "portion_bps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          },
          "description": "Rust additionally requires portion_bps to sum to 10000 and directions to be consistent."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "DECISION"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "rationale",
          "decision"
        ],
        "properties": {
          "rationale": {
            "$ref": "#/$defs/rationale"
          },
          "decision": {
            "$ref": "#/$defs/paper_proposal"
          },
          "missing_fields": {
            "maxItems": 0
          },
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NO_ACTION"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "type": "null"
          },
          "missing_fields": {
            "maxItems": 0
          },
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "INSUFFICIENT_DATA"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "missing_fields"
        ],
        "properties": {
          "decision": {
            "type": "null"
          },
          "missing_fields": {
            "minItems": 1
          },
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "decision": {
            "type": "null"
          },
          "missing_fields": {
            "maxItems": 0
          },
          "error_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
